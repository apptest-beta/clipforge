# ───────────────────────────────────────────────────────────────────────────
# ClipForge web app — environment variables
# Copy this file to `.env.local` and fill in your own values. Never commit
# `.env.local` (it is gitignored). All values below are placeholders.
# ───────────────────────────────────────────────────────────────────────────

# Supabase (Project Settings → API). The anon key is safe to expose to the
# browser; row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudinary cloud name — used by /api/export as the SSRF allow-list prefix
# for clip URLs. (The API key/secret and GEMINI_API_KEY now live on the
# cutter service, which runs the actual video analysis and rendering.)
CLOUDINARY_CLOUD_NAME=your-cloud-name

# UploadThing — direct browser-to-storage uploads for source videos.
# https://uploadthing.com/dashboard → API Keys
UPLOADTHING_TOKEN=your-uploadthing-token

# Upstash Redis — per-IP rate limiting on the API routes.
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional: override the Railway cutter base URL. If unset, the app uses the
# default production cutter. No trailing slash.
# CUTTER_URL=https://clipforge-cutter-production.up.railway.app

# Shared secret sent to the cutter service on every /api/cut call
# (x-cutter-secret header). Must match the CUTTER_SECRET configured on the
# cutter — without it the cutter rejects all cut requests.
CUTTER_SECRET=your-shared-cutter-secret
